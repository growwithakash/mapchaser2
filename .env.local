# Public — safe to expose client-side (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://wadfkczjvollgdcgwyrl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_2E9xetQHqbbrLPz_aTqidA_62sOyB5k

# SECRET — server-only. Get from Supabase Dashboard > Project Settings > API > service_role.
# NEVER prefix this with NEXT_PUBLIC_. NEVER commit it. NEVER send it to the browser.
# Used by app/api/account/delete and the automated moderation pipeline.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SECRET — server-only. Get from https://console.anthropic.com (your own Anthropic account/billing).
# Powers real automated relevance/quality/safety checks on every photo upload
# (app/api/moderate). Without this key, every upload fails safely to manual_review —
# nothing is ever auto-approved without it.
ANTHROPIC_API_KEY=your-anthropic-api-key

# SECRET — server-only. Get from https://resend.com (free tier available).
# Sends real emails on upload approval/rejection, withdrawal status changes,
# account suspension, and copyright-claim acknowledgment. Without this key,
# notifications are logged to the `notifications` table as "skipped_no_api_key"
# but never block the underlying action — emails just don't go out.
RESEND_API_KEY=your-resend-api-key

# Optional. Must be a domain you've verified in Resend, e.g. "Map Chaser <hello@yourdomain.com>".
# Defaults to Resend's shared test sender, which only delivers to your own
# Resend account's verified email — fine for testing, not for real users.
NOTIFICATIONS_FROM_EMAIL=Map Chaser <onboarding@resend.dev>
